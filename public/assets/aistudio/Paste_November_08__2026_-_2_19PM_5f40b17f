## 7.3 SQL Schema – Initial Migration

ตัวอย่าง SQL สำหรับเริ่มต้นสร้างฐานข้อมูล

```

-- 1. User Profiles
create table public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  display_name text,
  preferred_feedback_language text default 'th',
  created_at timestamptz default now()
);

-- 2. Writing Tasks
create table public.writing_tasks (
  id uuid primary key default gen_random_uuid(),
  title text not null,
  cefr_level text not null
    check (cefr_level in ('B1','B2','C1')),
  category text not null,
  topic text not null,
  instructions text not null,
  requirements jsonb not null default '[]',
  min_words integer,
  max_words integer,
  time_limit_minutes integer,
  task_version text not null default '1.0',
  is_published boolean default false,
  created_at timestamptz default now()
);

-- 3. Writing Drafts
create table public.writing_drafts (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id),
  task_id uuid not null references public.writing_tasks(id),
  content text not null default '',
  updated_at timestamptz default now()
);

-- 4. Submissions
create table public.writing_submissions (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id),
  task_id uuid not null references public.writing_tasks(id),
  original_text text not null,
  word_count integer not null,
  submitted_at timestamptz default now(),
  status text default 'pending'
    check (status in ('pending','processing','completed','failed'))
);

-- 5. Assessment Results
create table public.assessments (
  id uuid primary key default gen_random_uuid(),
  submission_id uuid unique not null
    references public.writing_submissions(id),
  total_score numeric(5,2) not null,
  grade text not null,
  cefr_estimate text not null,
  cefr_confidence text,
  category_scores jsonb not null,
  feedback jsonb not null,
  rubric_version text not null,
  ai_model text,
  created_at timestamptz default now()
);

-- 6. Assessment Errors
create table public.assessment_errors (
  id uuid primary key default gen_random_uuid(),
  assessment_id uuid not null
    references public.assessments(id) on delete cascade,
  category text not null,
  subcategory text not null,
  original_text text not null,
  corrected_text text,
  explanation text,
  start_offset integer,
  end_offset integer,
  severity text,
  confidence numeric(4,3),
  examples jsonb default '[]'
);

-- 7. Vocabulary Bank
create table public.vocabulary_bank (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id),
  word text not null,
  meaning text,
  example_sentence text,
  source_submission_id uuid
    references public.writing_submissions(id),
  created_at timestamptz default now()
);

-- 8. Learning Progress
create table public.learning_progress (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id),
  skill text not null,
  cefr_level text,
  score numeric(5,2),
  source_assessment_id uuid
    references public.assessments(id),
  recorded_at timestamptz default now()
);

-- 9. Grammar Lessons
create table public.grammar_lessons (
  id uuid primary key default gen_random_uuid(),
  title text not null,
  topic text not null,
  cefr_level text,
  explanation text not null,
  examples jsonb default '[]',
  exercises jsonb default '[]',
  published boolean default false
);

-- 10. Learning Recommendations
create table public.learning_recommendations (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id),
  assessment_id uuid references public.assessments(id),
  lesson_id uuid references public.grammar_lessons(id),
  skill text not null,
  reason text,
  status text default 'recommended',
  created_at timestamptz default now()
);

-- Indexes
create index idx_submissions_user
on public.writing_submissions(user_id, submitted_at desc);

create index idx_assessments_submission
on public.assessments(submission_id);

create index idx_errors_assessment
on public.assessment_errors(assessment_id);

create index idx_vocab_user
on public.vocabulary_bank(user_id);

```

นี่เป็น Initial Schema สำหรับเริ่มพัฒนา ยังต้องเพิ่ม Foreign Key สำหรับ ownership validation, unique constraints, triggers, updated_at และ migration tests ก่อน Production

## 7.4 Security – Row Level Security

ระบบต้องเปิด RLS สำหรับข้อมูลส่วนบุคคลทุกตาราง

ตัวอย่าง:

```

alter table public.profiles enable row level security;
alter table public.writing_drafts enable row level security;
alter table public.writing_submissions enable row level security;
alter table public.assessments enable row level security;
alter table public.assessment_errors enable row level security;
alter table public.vocabulary_bank enable row level security;
alter table public.learning_progress enable row level security;

create policy "Users can view own profile"
on public.profiles
for select
using (auth.uid() = id);

create policy "Users can view own drafts"
on public.writing_drafts
for select
using (auth.uid() = user_id);

create policy "Users can insert own submissions"
on public.writing_submissions
for insert
with check (auth.uid() = user_id);

create policy "Users can view own submissions"
on public.writing_submissions
for select
using (auth.uid() = user_id);

create policy "Users can view own vocabulary"
on public.vocabulary_bank
for select
using (auth.uid() = user_id);

```

ข้อกำหนดด้านความปลอดภัยเพิ่มเติม

- ห้ามให้ผู้ใช้สร้างหรือแก้ไขผลคะแนนเอง
- การสร้าง Assessment ต้องทำผ่าน Backend เท่านั้น
- ห้ามเปิดเผย AI API Key ใน Frontend
- Service Role Key ต้องอยู่ใน Server Environment
- ตรวจสอบเจ้าของ Submission ก่อนประมวลผล
- จำกัดจำนวนการส่งงานและ API Rate Limit
- ป้องกัน Prompt Injection จากข้อความที่ผู้ใช้เขียน
- มีระบบลบข้อมูลและขอส่งออกข้อมูล
- เก็บข้อมูลเท่าที่จำเป็นและกำหนดระยะเวลาเก็บข้อมูล

