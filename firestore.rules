rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Submissions (Evaluations) collection
      match /submissions/{submissionId} {
        allow read, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(submissionId);
        allow delete: if isOwner(userId);
      }

      // Vocabulary bank collection
      match /vocabulary/{vocabId} {
        allow read, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(vocabId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
